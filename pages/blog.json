{
  "root": {
    "type": "component",
    "component": "Layout",
    "children": [
      {
        "type": "component",
        "component": "Section",
        "children": [
          {
            "type": "node",
            "tag": "div",
            "style": {
              "base": {
                "display": "flex",
                "flexDirection": "column",
                "justifyContent": "flex-start",
                "alignItems": "center",
                "textAlign": "center",
                "marginBottom": "52px"
              },
              "tablet": {},
              "mobile": {}
            },
            "children": [
              {
                "type": "component",
                "component": "Subtitle",
                "props": {
                  "text": "Blog"
                }
              },
              {
                "type": "component",
                "component": "Heading",
                "props": {
                  "text": "All articles"
                },
                "style": {
                  "base": {
                    "marginBottom": "var(--h-m)",
                    "textAlign": "center"
                  }
                }
              },
              {
                "type": "component",
                "component": "Text",
                "props": {
                  "text": "Browse every post, tutorial, and insight we've published."
                },
                "style": {
                  "base": {
                    "textAlign": "center",
                    "maxWidth": "520px"
                  }
                }
              }
            ]
          },
          {
            "type": "node",
            "tag": "div",
            "style": {
              "base": {
                "display": "grid",
                "gridTemplateColumns": "1fr 1fr 1fr",
                "gap": "16px"
              },
              "tablet": {},
              "mobile": {}
            },
            "children": [
              {
                "type": "list",
                "sourceType": "collection",
                "source": "blog",
                "itemAs": "post",
                "sort": {
                  "field": "_createdAt",
                  "order": "desc"
                },
                "children": [
                  {
                    "type": "link",
                    "href": "{{post._url}}",
                    "style": {
                      "base": {
                        "display": "flex",
                        "flexDirection": "column",
                        "justifyContent": "flex-start",
                        "alignItems": "stretch",
                        "backgroundColor": "var(--bg)",
                        "borderRadius": "8px",
                        "overflow": "hidden",
                        "border": "1px solid",
                        "borderColor": "var(--border)",
                        "color": "var(--text)",
                        "textDecoration": "none"
                      },
                      "tablet": {},
                      "mobile": {}
                    },
                    "children": [
                      {
                        "type": "node",
                        "tag": "img",
                        "style": {
                          "base": {
                            "aspectRatio": "16 / 10",
                            "objectFit": "cover"
                          },
                          "tablet": {},
                          "mobile": {}
                        },
                        "attributes": {
                          "src": "{{post.image}}",
                          "alt": "{{post.title}}"
                        }
                      },
                      {
                        "type": "node",
                        "tag": "div",
                        "style": {
                          "base": {
                            "padding": "24px",
                            "display": "flex",
                            "flexDirection": "column",
                            "alignItems": "flex-start",
                            "gap": "12px"
                          },
                          "tablet": {},
                          "mobile": {}
                        },
                        "children": [
                          {
                            "type": "component",
                            "component": "Badge",
                            "props": {
                              "text": "{{post.category}}"
                            }
                          },
                          {
                            "type": "component",
                            "component": "Heading",
                            "props": {
                              "text": "{{post.title}}"
                            },
                            "style": {
                              "base": {
                                "fontSize": "var(--head-fs)",
                                "margin": "0"
                              }
                            }
                          },
                          {
                            "type": "component",
                            "component": "Text",
                            "props": {
                              "text": "{{post.date}}"
                            },
                            "style": {
                              "base": {
                                "fontSize": "var(--te-fs)",
                                "color": "var(--muted)"
                              }
                            }
                          },
                          {
                            "type": "component",
                            "component": "Text",
                            "props": {
                              "text": "{{post.description}}"
                            },
                            "style": {
                              "base": {
                                "marginTop": "4px"
                              }
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "meta": {
    "title": "Blog",
    "description": "Browse all articles, tutorials, and insights."
  }
}